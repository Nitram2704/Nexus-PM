# ── Nexus-PM Frontend — Environment Variables ────────────────────────────────
# Copia este archivo a `.env` y ajusta los valores.
# Solo las variables con prefijo VITE_ se exponen al código del cliente.

# ── API Backend ──────────────────────────────────────────────────────────────
# URL base de la API Django (default si se omite: http://localhost:8000/api).
VITE_API_URL=http://localhost:8000/api

# ── Supabase (opcional) ──────────────────────────────────────────────────────
# Usadas en src/lib/supabase.ts para realtime.
# Si se omiten, las features realtime se desactivan (la app sigue funcionando).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
