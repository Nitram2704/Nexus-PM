# ── Nexus-PM Backend — Environment Variables ─────────────────────────────────
# Copia este archivo a `.env` y ajusta los valores.
# Todas las variables se leen en backend/nexus/settings.py vía python-decouple.

# ── Core (requerido) ──────────────────────────────────────────────────────────
# Clave secreta de Django. GENERA UNA NUEVA, nunca uses esta en producción.
# Ej: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-secret-key

# Modo debug (True/False). Usa False en producción.
DEBUG=True

# Hosts permitidos, separados por coma.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de datos (PostgreSQL opcional) ──────────────────────────────────────
# Si OMITES DB_HOST (o lo dejas vacío), Django usa SQLite automáticamente
# (archivo db.sqlite3) — no necesitas configurar nada más para desarrollo local.
# Para usar PostgreSQL: descomenta y completa estas variables, e instala
# psycopg2-binary (ver requirements.txt).
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=nexuspm
# DB_USER=postgres
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=5432

# ── JWT ──────────────────────────────────────────────────────────────────────
# Duración del access token en horas (default: 24).
JWT_ACCESS_TOKEN_LIFETIME_HOURS=24
# Duración del refresh token en días (default: 7).
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes permitidos, separados por coma (default: http://localhost:5173).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── IA (opcional) ────────────────────────────────────────────────────────────
# Google API Key para el SDK google-genai (modelo gemini-2.5-flash).
# OPCIONAL: si la omites (o dejas el placeholder), las features de IA
# (backlog, user stories, chat) caen automáticamente a mock data.
GOOGLE_API_KEY=your-api-key-here
